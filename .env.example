# ============================================================================
# 1. ZaFar Email Auth & Shared Backend Service (Koyeb + Gmail SMTP + D1)
# ============================================================================
# Public URL of your deployed zafar-backend service (used for unified email auth & quota)
ZAFAR_AUTH_API_URL=https://bloody-brigitta-ahzafar-de9b1709.koyeb.app

# Direct Gmail STARTTLS SMTP (recommended on Vercel for instant <1.5s OTP delivery to ANY email domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Shared HS256 JWT secret (set to the same JWT_SECRET_KEY used by zafar-backend)
JWT_SECRET_KEY=

# Optional direct Cloudflare D1 persistence (uses the same D1 database as zafar-backend)
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Primary administrator email address
ADMIN_EMAIL=troykunsauka6@gmail.com

# ============================================================================
# 2. Optional Live WhatsApp Bot Control Server (admin-server.js)
# ============================================================================
BOT_API_URL=
ADMIN_DASHBOARD_TOKEN=
