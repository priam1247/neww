# Base URL of the running ZaFar Bot admin server (e.g. http://203.0.113.10:3000)
# Leave blank to run in interactive Sandbox Preview mode until your bot panel URL is ready.
BOT_API_URL=

# Shared bearer secret matching ADMIN_DASHBOARD_TOKEN in the bot's .env
ADMIN_DASHBOARD_TOKEN=

# Optional operator identity badge shown in the Control Room header
NEXT_PUBLIC_ADMIN_EMAIL=troykunsauka6@gmail.com
