# ============================================================================
# ZaFar WhatsApp Bot — Environment Configuration (.env.example)
# ============================================================================
# Copy to .env (git-ignored) or set as Pterodactyl Startup Variables.
# ROLLOUT ORDER FOR ROTATING SECRETS:
#   1. Set these variables in .env / Panel Startup Variables FIRST.
#   2. Deploy the updated bot code SECOND and verify .status / .paper / .movie.
#   3. Revoke / rotate old exposed API keys LAST.

# ── Bot Identity & Pairing ───────────────────────────────────────────────────
PREFIX=.
BOT_NAME=ZaFar Bot
OWNER_NUMBER=265894016453
# Leave PAIR_NUMBER empty to pair interactively from the web dashboard (/admin),
# or set digits with country code (e.g. 265991234567) for automatic CLI pairing:
PAIR_NUMBER=
SESSION_NAME=session
TZ=Africa/Blantyre

# ── Drime Cloud Past-Paper Vault (.paper / .countpapers) ─────────────────────
DRIME_API_TOKEN=
DRIME_BASE_URL=https://app.drime.cloud/api/v1
DRIME_PAPERS_FOLDER_ID=841342462
DRIME_PAPERS_FOLDER_HASH=ODQxMzQyNDYyfA
DRIME_WORKSPACE_ID=0

# ── Movies & Series Metadata / Debrid (.movie / .series) ─────────────────────
# TMDB is optional (Cinemeta, IMDb, TVMaze, Jikan, and AniList work keyless)
TMDB_API_KEY=
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
DEBRID_API_KEY=
TORRENT_DIRECT=true

# ── Media Fallbacks & YouTube (.song / .ytv / .dl) ───────────────────────────
GIFTED_API_KEY=
YOUTUBE_COOKIES_FILE=
YTDLP_PROXY=

# ── Web Dashboard Bridge (`utils/adminApi.js`, started by `index.js`) ────────
ADMIN_DASHBOARD_TOKEN=
ADMIN_API_PORT=3000
# Optional comma-separated browser origins allowed by CORS (server-to-server needs none)
ADMIN_CORS_ORIGINS=
# Optional dashboard URL for pull-based allowlist sync when behind NAT
DASHBOARD_URL=
DASHBOARD_SYNC_MINUTES=5

# ── Pterodactyl Panel Restart (.restart command) ─────────────────────────────
# Use a dedicated restricted panel subuser key (ptlc_...) with control.restart only
PANEL_URL=
PANEL_SERVER_ID=
PANEL_API_KEY=

# ── 10 GB Plan Disk Guard & Queue Concurrency ────────────────────────────────
DISK_BUDGET_MB=9000
TEMP_MAX_MB=2048
QUEUE_LIGHT=20
QUEUE_HEAVY=2
MOVIE_CONCURRENCY=2
