# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# On a Pterodactyl panel you can set these as startup variables instead.

# Real-Debrid (https://real-debrid.com/apitoken) — unlocks the torrent tier
REALDEBRID_API_KEY=
# AllDebrid alternative (https://alldebrid.com/apikeys)
ALLDEBRID_API_KEY=
# Generic alias, treated as Real-Debrid when REALDEBRID_API_KEY is empty
DEBRID_API_KEY=

# TMDB (free, themoviedb.org/settings/api) — titles/posters
TMDB_API_KEY=

# Optional tuning
# SKIP_TORRENT_WITHOUT_DEBRID=false   # try torrents anyway (they will fail without debrid)
# MAX_DOWNLOAD_MB=4096
# LOG_LEVEL=debug
