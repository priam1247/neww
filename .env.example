# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# On a Pterodactyl panel you can set these as startup variables instead.

# Real-Debrid (https://real-debrid.com/apitoken) — unlocks the torrent tier
REALDEBRID_API_KEY=
# AllDebrid alternative (https://alldebrid.com/apikeys)
ALLDEBRID_API_KEY=
# Generic alias, treated as Real-Debrid when REALDEBRID_API_KEY is empty
DEBRID_API_KEY=

# TMDB (free, themoviedb.org/settings/api) — titles/posters
TMDB_API_KEY=

# ── Web dashboard (portal) — optional ────────────────────────────────────────
# The portal links to this bot with a URL + token. Set the SAME token here that
# you paste in the portal's Admin Console, and open an extra port allocation on
# the panel (this is the port the portal connects to).
# ADMIN_DASHBOARD_TOKEN=
# ADMIN_API_PORT=3000
# DASHBOARD_URL=https://your-portal.pages.dev     # enables whitelist pull sync
# DASHBOARD_SYNC_MINUTES=5

# Optional tuning
# Heap for the bot. Leave empty: it is sized from RAM automatically
# (RAM − 450 MB, capped at 4200 MB — a 4.5 GB box gets ~4160 MB).
# HEAP_MB=4100
# Nothing is cached: delivered files are deleted after sending.
# TEMP_MAX_MB=1024
# 20 link downloads / 4 movie jobs at once, with a RAM guard
# QUEUE_LIGHT=20
# QUEUE_HEAVY=4
# QUEUE_MIN_FREE_MB=220
# MOVIE_CONCURRENCY=3
# Without a debrid key the bot downloads seeded magnets itself (WebTorrent).
# TORRENT_DIRECT=false        # never download torrents without a debrid key
# SKIP_TORRENT_WITHOUT_DEBRID=true   # old behaviour: skip the torrent tier entirely
# MAX_DOWNLOAD_MB=4096
# LOG_LEVEL=debug
