{
    "name": "zafar-bot",
    "version": "2.2.0",
    "description": "ZaFar WhatsApp bot powered by Baileys",
    "main": "index.js",
    "type": "commonjs",
    "scripts": {
        "start": "node --expose-gc --max-old-space-size=3072 index.js",
        "dev": "nodemon index.js",
        "install:no-puppeteer": "PUPPETEER_SKIP_DOWNLOAD=true PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true npm install",
        "ytdlp:install": "bash scripts/install-ytdlp.sh",
        "selftest": "node scripts/selftest.js",
        "check": "node scripts/selftest.js"
    },
    "keywords": [
        "whatsapp bot",
        "baileys"
    ],
    "author": "ZaFar",
    "license": "MIT",
    "dependencies": {
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "axios": "^1.7.2",
        "ffmpeg-static": "^5.3.0",
        "node-webpmux": "^3.1.7",
        "pino": "^9.0.0",
        "qrcode-terminal": "^0.12.0",
        "rlottie": "^0.1.2",
        "ruhend-scraper": "^9.0.8",
        "yt-search": "^2.13.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.0"
    },
    "engines": {
        "node": ">=18.17"
    }
}
