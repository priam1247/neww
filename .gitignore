# dependencies
node_modules/

# WhatsApp credentials — never commit
session/
*.session/

# runtime scratch (also used by the movie/series engine)
temp/
data/
*.log

# runtime settings written by the bot itself
database/media_settings.json
database/*.bak
database/*.corrupt*
database/*.tmp

# local secrets
.env

# dashboard sync state (runtime)
database/dashboard_sync.json

# web portal build output (dashboard/)
.next/
dashboard/.next/
.vercel/
next-env.d.ts

# next.js incremental build info
dashboard/tsconfig.tsbuildinfo
