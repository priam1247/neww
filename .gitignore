# dependencies & runtime-fetched standalone binaries
node_modules/
bin/

# WhatsApp credentials — never commit
session/
*.session/

# runtime scratch (also used by the movie/series engine)
temp/
data/
*.log

# runtime state & vault snapshots written by the bot itself (never overwrite on deploy)
database/*.json
database/*.bak
database/*.corrupt*
database/*.tmp

# local secrets
.env

# web portal build output (dashboard/)
.next/
dashboard/.next/
dashboard/.data/
dashboard/next-env.d.ts
.vercel/
next-env.d.ts

# next.js incremental build info
dashboard/tsconfig.tsbuildinfo
